# Copy to .env locally. Never commit .env. These are server settings, not secrets.
HOST=0.0.0.0
PORT=8080
RDX_MAX_FILE_MB=512
RDX_MAX_DURATION_SECONDS=1800
RDX_MAX_JOB_SECONDS=1200
RDX_MAX_WORKERS=2
RDX_RATE_BYTES=4194304
RDX_REQUESTS_PER_MINUTE=8
# Same-origin Docker hosting: leave empty. Pages: allow the exact origin (no path).
# Example: https://hriduan.github.io
RDX_ALLOWED_ORIGINS=
# Proxy IP is intentionally used for in-app rate limits; set per-client limits at your proxy.
